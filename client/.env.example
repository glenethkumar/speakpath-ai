# =================================================================
# SpeakPath AI - Frontend Environment Configuration (Vite / Vercel)
# =================================================================

# Production Backend URL (e.g., your deployed Render or Railway service)
# When deploying frontend on Vercel, set this to your backend service domain.
# In local development, leave this EMPTY to use Vite's built-in dev proxy.
VITE_API_BASE_URL=https://your-backend-app.onrender.com

# (Optional) Explicit WebSocket URL if different from VITE_API_BASE_URL
# If omitted, SpeakPath AI automatically converts https:// -> wss:// from VITE_API_BASE_URL
# VITE_WS_BASE_URL=wss://your-backend-app.onrender.com
