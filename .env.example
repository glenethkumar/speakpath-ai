# =================================================================
# SpeakPath AI - Environment Configuration
# =================================================================
# IMPORTANT: Never commit actual API keys to version control.
# Copy this file to .env and insert your real credentials.

# 1. Primary AI Provider: Google Gemini API (https://aistudio.google.com/)
# Used for real-time Gemini Live bidirectional speech and turn-by-turn English corrections.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LiveKit Cloud Credentials (https://cloud.livekit.io/)
# Powers WebRTC real-time audio rooms with voice agents.
# If omitted, SpeakPath AI operates via direct bidirectional 16kHz PCM WebSockets.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# 3. Optional OpenRouter API Key (https://openrouter.ai/keys)
# Extracted from E-Bot-2026. If provided, enables Alibaba Qwen3.5/3.7-Flash fallback.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Voice & Speech Synthesis Defaults (E-Bot v3.5 defaults)
DEFAULT_SPEECH_VOICE=Google UK English Female
DEFAULT_SPEECH_LANG=en-GB
MAX_HISTORY_PAIRS=20

# 5. Server Port
PORT=5000
